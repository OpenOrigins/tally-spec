{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/tally_session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://api.prod.openorigins.com/v1/tally/logs",
            "headers": {
              "x-api-key": "$OO_API_KEY"
            },
            "timeout": 10,
            "allowedEnvVars": [
              "OO_API_KEY"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
